[Unit]
Description=BNDS Host Competition Timer (主持人大赛计时)
Documentation=file:/opt/bnds-timer/README.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=bnds
Group=bnds
WorkingDirectory=/opt/bnds-timer
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=80
Environment=PORTS=8080
Environment=STATE_FILE=/var/lib/bnds-timer/state.json
# 需要口令时才填：Environment=CONTROL_KEY=xxxx
ExecStart=/usr/local/bin/node /opt/bnds-timer/server.js

Restart=always
RestartSec=1.5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bnds-timer

# —— 加固：非 root 运行，仅授予监听 80 端口的能力 ——
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/var/lib/bnds-timer

[Install]
WantedBy=multi-user.target
